# ─────────────────────────────────────────────────────────────────
# VíaBaq Backend — Production Environment Variables
# Copy this file to .env and fill in real values for your deployment
# ─────────────────────────────────────────────────────────────────

# Server
NODE_ENV=production
PORT=4000
API_VERSION=v1

# Database (Railway PostgreSQL with PostGIS)
# On Railway: use the DATABASE_URL or individual vars from the PostgreSQL plugin
DB_HOST=your-railway-postgres-host.railway.app
DB_PORT=5432
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=your_strong_db_password_here

# Redis (Railway Redis plugin)
REDIS_HOST=your-railway-redis-host.railway.app
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ML Service (deploy as separate Railway service)
ML_SERVICE_URL=https://viabaq-ml-service.up.railway.app

# Frontend (Next.js — can be on Vercel or Railway)
FRONTEND_URL=https://viabaq.vercel.app

# External APIs
OPENWEATHER_API_KEY=your_openweather_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
TOMTOM_API_KEY=your_tomtom_api_key_here

# Security
JWT_SECRET=generate_a_strong_random_secret_min_32_chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────
# RAILWAY DEPLOYMENT NOTES
# ─────────────────────────────────────────────────────────────────
#
# 1. Connect your GitHub repo to Railway
# 2. Create services:
#    - Backend: this Node.js app (uses server/Dockerfile)
#    - PostgreSQL: Railway PostgreSQL plugin + install PostGIS extension
#    - Redis: Railway Redis plugin
#    - ML Service: ml-service/ directory (uses ml-service/Dockerfile)
#
# 3. Railway auto-fills DATABASE_URL — you can use it directly or
#    split into DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD
#
# 4. After first deploy, run migrations:
#    railway run --service backend npm run db:migrate
#    railway run --service backend npm run db:seed
#
# 5. GitHub Education benefit: Railway Developer plan is free via
#    the GitHub Student Developer Pack at https://railway.app/education
